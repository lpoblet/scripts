# Template for restic repository configuration
# Copy this to /etc/restic/<name>.repo.env and fill in the values

# The location of the restic repository
# Local: /mnt/backup/restic
# SFTP: sftp:user@host:/path/to/repo
# S3: s3:s3.amazonaws.com/bucket-name
RESTIC_REPOSITORY="/mnt/backups/change-me"

# The file containing the repository password
RESTIC_PASSWORD_FILE="/etc/restic/change-me.repo.key"

# Compression level (auto, off, max) - requires restic >= 0.14.0
# RESTIC_COMPRESSION="auto"

# Force the hostname (useful for keeping snapshots consistent)
# RESTIC_HOST="my-host"

# Additional environment variables for cloud providers:

# Amazon S3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Backblaze B2
# B2_ACCOUNT_ID=""
# B2_ACCOUNT_KEY=""

# Azure Blob Storage
# AZURE_ACCOUNT_NAME=""
# AZURE_ACCOUNT_KEY=""
