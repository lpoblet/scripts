#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backup/system/"
# export RESTIC_PASSWORD_FILE="/etc/restic/system.repo.key"

# Load environment variables
if [ -f /etc/restic/restic.remote.repo.env ]; then
    source /etc/restic/restic.remote.repo.env
else
    echo "ERROR: Environment file /etc/restic/restic.remote.repo.env not found!"
    exit 1
fi

# Verify variables are set
if [ -z "$RESTIC_REPOSITORY" ]; then
    echo "ERROR: RESTIC_REPOSITORY is not set!"
    exit 1
fi

# Network check
if ! ping -c 1 -W 2 192.168.100.154 >/dev/null 2>&1; then
    echo "Server unreachable, skipping backup"
    exit 0
fi

# Export package lists
echo "Exporting package lists..."
PACKAGE_LIST_DIR="/var/backups/package-lists"
mkdir -p "$PACKAGE_LIST_DIR"

if [ -f /etc/arch-release ]; then
    echo "Detected Arch Linux"
    pacman -Qqe > "$PACKAGE_LIST_DIR/all-packages.txt"
    pacman -Qqen > "$PACKAGE_LIST_DIR/native-packages.txt"
    pacman -Qqem > "$PACKAGE_LIST_DIR/foreign-packages.txt"
elif [ -f /etc/debian_version ]; then
    echo "Detected Debian/Ubuntu"
    dpkg --get-selections > "$PACKAGE_LIST_DIR/all-packages.txt"
elif [ -f /etc/fedora-release ]; then
    echo "Detected Fedora"
    dnf list > "$PACKAGE_LIST_DIR/all-packages.txt"
else
    echo "Unknown OS, skipping package list export."
fi

echo "Starting system backup at $(date)"
systemd-notify --ready --status="System backup in progress..."

# Set DBUS for GUI notifications
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

#echo "$RESTIC_REPOSITORY"
#echo "$RESTIC_PASSWORD_FILE"
# Optional: run this command to check the use of the password
# restic -r "$RESTIC_REPOSITORY" snapshots

# Run the backup
if restic -r "$RESTIC_REPOSITORY" --verbose --tag "system" backup --one-file-system / --exclude-file="/usr/local/bin/restic-system-exclude"; then
    notify-send -u low -i document-save "Restic Remote System Backup" "Remote system backup completed successfully!" 2>/dev/null || true
    echo "Remote System backup completed successfully"
    exit 0
else
    notify-send -u critical -i dialog-error "Restic Remote System Backup" "Remote system backup failed! Check journal logs." 2>/dev/null || true
    echo "Remote System backup failed!"
    exit 1
fi

# Maintain backups - Keep 7 daily, 4 weekly, and 12 monthly backups
echo "Pruning old backups..."
restic forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 12 \
  --prune \
  --tag "system"

# Check repository integrity
echo "Checking repository integrity..."
restic -r "$RESTIC_REPOSITORY" check

# Delete environment variables
unset RESTIC_PASSWORD
unset RESTIC_REPOSITORY
unset RESTIC_PASSWORD_FILE

echo "Remote System backup completed at $(date)"
systemd-notify --ready --status="Remote System backup completed..."
