#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backup/system/"
# export RESTIC_PASSWORD_FILE="/etc/restic/system.repo.key"

# Load environment variables
if [ -f /etc/restic/remote.repo.env ]; then
    source /etc/restic/remote.repo.env
else
    echo "ERROR: Environment file /etc/restic/remote.repo.env not found!"
    exit 1
fi

# Verify variables are set
if [ -z "$RESTIC_REPOSITORY" ]; then
    echo "ERROR: RESTIC_REPOSITORY is not set!"
    exit 1
fi

# Check network connectivity to the server
echo "------------------------------------------------------------------------"
echo "Checking connection to the server..."
if ! ssh -q x1c3 exit >/dev/null 2>&1; then
    echo "Server unreachable via SSH, skipping backup"
    exit 1
fi

echo "------------------------------------------------------------------------"
echo "Starting system backup at $(date)"

# Run the backup for system files only
# Remove --dry-run once tested
# Use: "backup --one-file-system / " for a wider system backup
if restic -r "$RESTIC_REPOSITORY" --dry-run --verbose --tag "system" backup /etc /boot; then
    echo "Remote System backup completed successfully"
    #exit 0
else
    echo "Remote System backup failed!"
    exit 1
fi

# Maintain backups - Keep 7 daily, 4 weekly, and 12 monthly backups
echo "------------------------------------------------------------------------"
echo "Pruning old backups..."
if restic -r "$RESTIC_REPOSITORY" forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 12 \
  --prune \
  --tag "system"; then
    echo "Remote System Prunning completed successfully"
    #exit 0
else
    echo "Remote System Prunning failed!"
    exit 1
fi

# Check repository integrity
echo "------------------------------------------------------------------------"
echo "Checking repository integrity..."
if restic -r "$RESTIC_REPOSITORY" check; then
    echo "Remote System Check completed successfully"
    #exit 0
else
    echo "Remote System Check failed!"
    exit 1
fi

# Delete environment variables
unset RESTIC_REPOSITORY
unset RESTIC_PASSWORD_FILE
unset RESTIC_COMPRESSION
unset RESTIC_HOST
unset RESTIC_SFTP_COMMAND

echo "------------------------------------------------------------------------"
echo "Remote System backup completed at $(date)"
