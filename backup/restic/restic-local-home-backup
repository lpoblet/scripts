#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backups/local/"
# export RESTIC_PASSWORD_FILE="/etc/restic/home.repo.key"

# Load environment variables
if [ -f /etc/restic/local.home.repo.env ]; then
    source /etc/restic/local.home.repo.env
else
    echo "ERROR: Environment file /etc/restic/local.repo.env not found!"
    exit 1
fi

# Verify variables are set
if [ -z "$RESTIC_REPOSITORY" ]; then
    echo "ERROR: RESTIC_REPOSITORY is not set!"
    exit 1
fi

# Run the backup
echo "Starting local home backup at $(date)"
systemd-notify --ready --status="Local Home Backup in progress..."

# Set DBUS for GUI notifications
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

# Optional: run this command to check the use of the password
# restic -r "$RESTIC_REPOSITORY" snapshots

# Do the backup - note "backup" comes before $HOME
# Use --dry-run (before --verbose) if needed
if restic -r "$RESTIC_REPOSITORY" --verbose --tag "home" backup /home/leo/ --exclude-file=/home/leo/.local/bin/restic-home-exclude; then
    notify-send -u low -i document-save "Restic Local Home Backup" "Local Home Backup completed successfully!" 2>/dev/null || true
    echo "Local Home Backup completed successfully"
    exit 0
else
    notify-send -u critical -i dialog-error "Restic Local Home Backup" "Local Home Backup failed! Check journal logs." 2>/dev/null || true
    echo "Local Home Backup failed!"
    exit 1
fi

# Maintain backups - Keep 7 daily, 4 weekly, and 12 monthly backups
echo "Pruning old backups..."
restic -r "$RESTIC_REPOSITORY" forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 12 \
  --prune \
  --tag "home"

# Check repository integrity
echo "Checking repository integrity..."
restic -r "$RESTIC_REPOSITORY" check

# Delete environment variables
unset RESTIC_REPOSITORY
unset RESTIC_PASSWORD_FILE
unset RESTIC_COMPRESSION
unset RESTIC_HOST

echo "Local Home Backup completed at $(date)"
systemd-notify --ready --status="Local Home Backup completed..."
