#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backup/home/"
# export RESTIC_PASSWORD_FILE="/etc/restic/home.repo.key"

# Load environment variables
if [ -f /etc/restic/remote.repo.env ]; then
    source /etc/restic/remote.repo.env
else
    echo "ERROR: Environment file /etc/restic/remote.repo.env not found!"
    exit 1
fi

# Verify variables are set
if [ -z "$RESTIC_REPOSITORY" ]; then
    echo "ERROR: RESTIC_REPOSITORY is not set!"
    exit 1
fi

# Export package lists
echo "------------------------------------------------------------------------"
echo "Exporting package lists..."
PACKAGE_LIST_DIR="/home/leo/backups/package-lists"
mkdir -p "$PACKAGE_LIST_DIR"

if [ -f /etc/arch-release ]; then
    echo "Detected Arch Linux"
    pacman -Qqe > "$PACKAGE_LIST_DIR/all-packages.txt"
    pacman -Qqen > "$PACKAGE_LIST_DIR/native-packages.txt"
    pacman -Qqem > "$PACKAGE_LIST_DIR/foreign-packages.txt"
elif [ -f /etc/debian_version ]; then
    echo "Detected Debian/Ubuntu"
    dpkg --get-selections > "$PACKAGE_LIST_DIR/all-packages.txt"
elif [ -f /etc/fedora-release ]; then
    echo "Detected Fedora"
    dnf list > "$PACKAGE_LIST_DIR/all-packages.txt"
else
    echo "Unknown OS, skipping package list export."
fi

# Check network connectivity to the server
echo "------------------------------------------------------------------------"
echo "Checking connection to the server..."
if ! ssh -q -o BatchMode=yes -o ConnectTimeout=3 leo@x1c3 exit >/dev/null 2>&1; then
    echo "Server unreachable via SSH, skipping backup"
    exit 1
fi

# Run the backup
echo "------------------------------------------------------------------------"
echo "Starting backup at $(date)"

# Remove --dry-run once tested
if restic -r "$RESTIC_REPOSITORY" --dry-run --verbose --tag "home" backup $HOME --exclude-file="$HOME/.local/bin/restic-home-exclude"; then
    echo "Restic Remote Home Backup completed successfully"
    #exit 0
else
    echo "Restic Remote Home Backup failed!"
    exit 1
fi

# Maintain backups - Keep 7 daily, 4 weekly, and 12 monthly backups
echo "------------------------------------------------------------------------"
echo "Pruning old backups..."
restic -r "$RESTIC_REPOSITORY" forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 12 \
  --prune \
  --tag "home"

# Check repository integrity
echo "------------------------------------------------------------------------"
echo "Checking repository integrity..."
restic -r "$RESTIC_REPOSITORY" check

# Delete environment variables
unset RESTIC_REPOSITORY
unset RESTIC_PASSWORD_FILE
unset RESTIC_COMPRESSION
unset RESTIC_HOST
unset RESTIC_SFTP_COMMAND

echo "------------------------------------------------------------------------"
echo "Restic Remote Home Backup completed at $(date)"
