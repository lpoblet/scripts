#!/bin/bash

# Terminate any running waybar instances cleanly
killall waybar 2>/dev/null

# Brief pause to let sockets close
sleep 0.2

# Launch waybar detached from the terminal session using nohup
nohup waybar \
    -c "$HOME/.config/waybar/config-x1c3.jsonc" \
    -s "$HOME/.config/waybar/style-x1c3.css" \
    > /dev/null 2>&1 &

# Detach the background job from the shell completely
disown

echo "Waybar reloaded successfully"
